@baseUrl = http://localhost:3000
@id = 6
@bulan = 2026-11

### GET - seluruh transaksi
GET {{baseUrl}}/pengeluaran

### POST - tambah transaksi
POST {{baseUrl}}/pengeluaran
Content-Type: application/json

{
  "keterangan": "Makan siang",
  "kategori": "Makanan",
  "posAnggaran": "Pokok",
  "nominal": 25000,
  "tanggal": "2026-11-23"
}

### GET - detail transaksi (ubah @id sesuai response POST)
GET {{baseUrl}}/pengeluaran/{{id}}

### PATCH - ubah transaksi
PATCH {{baseUrl}}/pengeluaran/{{id}}
Content-Type: application/json

{
  "nominal": 30000,
  "posAnggaran": "Nabung"
}

### DELETE - hapus transaksi
DELETE {{baseUrl}}/pengeluaran/{{id}}

### ERROR 404 - ID tidak ditemukan
GET {{baseUrl}}/pengeluaran/999999

### ERROR 409 - transaksi duplikat dengan data seed
POST {{baseUrl}}/pengeluaran
Content-Type: application/json

{
  "keterangan": "Belanja kebutuhan dapur",
  "kategori": "Makanan",
  "posAnggaran": "Pokok",
  "nominal": 85000,
  "tanggal": "2026-11-20"
}

### ERROR 400 - nominal tidak valid
POST {{baseUrl}}/pengeluaran
Content-Type: application/json

{
  "keterangan": "X",
  "kategori": "Makanan",
  "posAnggaran": "Pokok",
  "nominal": -100,
  "tanggal": "bukan-tanggal"
}

### GET - anggaran bulanan (null jika belum disimpan)
GET {{baseUrl}}/anggaran/{{bulan}}

### PUT - simpan / ubah anggaran bulanan
PUT {{baseUrl}}/anggaran/{{bulan}}
Content-Type: application/json

{
  "totalBulanan": 5000000,
  "pokok": 3000000,
  "nabung": 1250000,
  "belanja": 750000
}

### ERROR 400 - total alokasi tidak sama dengan uang bulanan
PUT {{baseUrl}}/anggaran/{{bulan}}
Content-Type: application/json

{
  "totalBulanan": 5000000,
  "pokok": 3000000,
  "nabung": 1000000,
  "belanja": 500000
}
